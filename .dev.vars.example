# 本地开发时复制为 .dev.vars；部署时全部填写在 Sites 服务端运行时变量中。
SIMULATION_MODE="false"

# 用户身份 OAuth。App Secret 与令牌加密密钥只能保存在服务端，绝不能以 NEXT_PUBLIC_ 开头。
FEISHU_APP_ID="cli_replace_me"
FEISHU_APP_SECRET=""
FEISHU_OAUTH_REDIRECT_URI="https://feishu-xueqiu-assistant.goodsnipe129.chatgpt.site/api/feishu/oauth/callback"
# 使用密码管理器生成一段至少 32 字符的随机值，用于 AES-GCM 加密 D1 中的用户令牌。
FEISHU_TOKEN_ENCRYPTION_KEY=""

# 真实 AI 整理；优先支持 DeepSeek，缺少任一项时明确显示规则模式，不会伪造 AI 结果。
AI_PROVIDER="deepseek"
AI_API_KEY=""
AI_MODEL="deepseek-chat"
AI_BASE_URL="https://api.deepseek.com"
OPENAI_API_KEY=""
OPENAI_MODEL=""

# 飞书事件订阅入口：只接收站点所有者选择的自有采集群；服务端验证，不在页面暴露密钥。
FEISHU_VERIFICATION_TOKEN=""
SITE_OWNER_USER_ID=""
FEISHU_ALLOWED_CHAT_IDS=""
FEISHU_ALLOWED_CHAT_NAMES=""

# Windows 本机 WebSocket 长连接（主入口）。仅写入本机配置文件，不上传网页或日志。
FEISHU_WS_ENABLED="true"
FEISHU_WS_BRIDGE_TOKEN=""
FEISHU_LOCAL_OWNER_ID="windows-owner"
